---
import Header from "@components/layout/Header.astro";
import Drawer from "@components/layout/Drawer.astro";
import Footer from "@components/layout/Footer.astro";
import FloatingWhatsApp from "@components/layout/FloatingWhatsApp.astro";
import PrivacyPolicyModal from "@components/legal/PrivacyPolicyModal.astro";
import JsonLd from "@components/seo/JsonLd.astro";
import "@styles/styles.css";

interface Props {
  title?: string;
  description?: string;
  waTopic?: string;
  keywords?: string;
  ogImage?: string;
  schemas?: Record<string, any>[];
}

const {
  title = "NORTIA | Asesoría y Cotización de Seguros en Colombia",
  description = "Cotiza seguros de vida, salud, autos, hogar y empresas en Colombia con Sura, Allianz y Bolívar. Asesoría experta en Bucaramanga y Santander. ¡Cotiza hoy!",
  waTopic = "general",
  keywords = "seguros colombia, asesoria en seguros, cotizar seguros bucaramanga, seguro de vida colombia, medicina prepagada, seguro de hogar, seguro todo riesgo autos, poliza cumplimiento empresas, sura, allianz, bolivar, nortia",
  ogImage = "https://nortia.com.co/assets/img/og-preview.webp",
  schemas = [],
} = Astro.props;

const siteUrl = "https://nortia.com.co";
const pathName = Astro.url.pathname.replace(/\/$/, "");
const canonicalUrl = pathName ? `${siteUrl}${pathName}` : `${siteUrl}/`;

// Schema.org Oficial de Agencia de Seguros / Servicios Financieros (SEO Local Bucaramanga & Colombia)
const organizationSchema = {
  "@context": "https://schema.org",
  "@type": ["InsuranceAgency", "FinancialService"],
  "@id": `${siteUrl}/#organization`,
  name: "NORTIA Corredores de Seguros",
  alternateName: ["NORTIA Seguros", "NORTIA"],
  url: `${siteUrl}/`,
  logo: {
    "@type": "ImageObject",
    url: `${siteUrl}/assets/img/brand/nortia-logo.png`,
    width: "320",
    height: "80"
  },
  image: ogImage,
  description: description,
  telephone: "+573239004028",
  email: "info@nortia.com.co",
  priceRange: "$$",
  currenciesAccepted: "COP",
  paymentAccepted: "Transferencia bancaria, PSE, Tarjeta de crédito, Débito automático",
  address: {
    "@type": "PostalAddress",
    addressLocality: "Bucaramanga",
    addressRegion: "Santander",
    postalCode: "680001",
    addressCountry: "CO"
  },
  geo: {
    "@type": "GeoCoordinates",
    latitude: 7.1193,
    longitude: -73.1227
  },
  areaServed: [
    {
      "@type": "City",
      name: "Bucaramanga",
      "@id": "https://es.wikipedia.org/wiki/Bucaramanga"
    },
    {
      "@type": "AdministrativeArea",
      name: "Santander",
      "@id": "https://es.wikipedia.org/wiki/Santander_(Colombia)"
    },
    {
      "@type": "Country",
      name: "Colombia",
      "@id": "https://es.wikipedia.org/wiki/Colombia"
    }
  ],
  openingHoursSpecification: [
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
      opens: "08:00",
      closes: "18:00"
    },
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: ["Saturday"],
      opens: "08:00",
      closes: "12:00"
    }
  ],
  sameAs: [
    "https://wa.me/573239004028",
    "https://www.instagram.com/nortiaseguros/",
    "https://www.facebook.com/profile.php?id=61593321252648"
  ]
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="NORTIA" />

    <!-- Directivas de Indexación para Motores de Búsqueda -->
    <meta
      name="robots"
      content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
    />

    <!-- Canónica e Internacionalización Hreflang para Colombia (SEO Técnico) -->
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="es-CO" href={canonicalUrl} />
    <link rel="alternate" hreflang="es" href={canonicalUrl} />
    <link rel="alternate" hreflang="x-default" href={canonicalUrl} />

    <!-- Preload de imagen Hero para optimización de LCP (Core Web Vitals) -->
    <link
      rel="preload"
      as="image"
      href="/assets/img/happy-family.webp"
      type="image/webp"
    />

    <!-- Georreferenciación para SEO Local (Bucaramanga, Santander, Colombia) -->
    <meta name="geo.region" content="CO-SAN" />
    <meta name="geo.placename" content="Bucaramanga, Santander, Colombia" />
    <meta name="geo.position" content="7.1193;-73.1227" />
    <meta name="ICBM" content="7.1193, -73.1227" />

    <!-- OpenGraph (WhatsApp, Facebook, LinkedIn) -->
    <meta property="og:site_name" content="NORTIA Seguros" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content="image/webp" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="NORTIA - Asesoría y Cotización de Seguros en Colombia" />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="NORTIA - Asesoría y Cotización de Seguros en Colombia" />

    <!-- Favicons & Apple Touch Icons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <!-- Preconnect & Fuentes Google -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400;1,500;1,600&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=swap"
      rel="stylesheet"
    />

    <!-- Datos Estructurados Schema.org (JSON-LD) para Rich Snippets en Google -->
    <JsonLd schema={organizationSchema} />
    {schemas.map((schema) => <JsonLd schema={schema} />)}
  </head>
  <body>
    <Header waTopic={waTopic} />
    <Drawer waTopic={waTopic} />

    <slot />

    <Footer waTopic={waTopic} />
    <FloatingWhatsApp waTopic={waTopic} />
    <PrivacyPolicyModal />

    <script>
      import { initInteractions } from "@scripts/interactions.js";
      initInteractions();
    </script>
  </body>
</html>
