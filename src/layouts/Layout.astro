---
import Header from '@components/layout/Header.astro';
import Drawer from '@components/layout/Drawer.astro';
import Footer from '@components/layout/Footer.astro';
import FloatingWhatsApp from '@components/layout/FloatingWhatsApp.astro';
import JsonLd from '@components/seo/JsonLd.astro';
import '@styles/styles.css';

interface Props {
  title?: string;
  description?: string;
  waTopic?: string;
  keywords?: string;
  ogImage?: string;
  schemas?: Record<string, any>[];
}

const {
  title = 'NORTIA | Seguros y Protección Patrimonial en Colombia',
  description = 'Compara seguros de vida, salud, hogar, autos y empresas en Colombia con las mejores aseguradoras. Asesoría experta y transparente.',
  waTopic = 'general',
  keywords = 'seguros colombia, asesoria seguros, seguro de vida, medicina prepagada, seguro de hogar, seguro todo riesgo autos, poliza cumplimiento empresas, nortia',
  ogImage = 'https://nortia.com.co/assets/img/happy-family.jpg',
  schemas = []
} = Astro.props;

const siteUrl = 'https://nortia.com.co';
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href.replace(/\/$/, '') || siteUrl;

// Schema.org Oficial de Agencia de Seguros
const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "InsuranceAgency",
  "@id": `${siteUrl}/#organization`,
  "name": "NORTIA",
  "url": siteUrl,
  "logo": `${siteUrl}/assets/img/brand/nortia-logo.png`,
  "image": `${siteUrl}/assets/img/happy-family.webp`,
  "description": description,
  "telephone": "+573239004028",
  "email": "info@nortia.com.co",
  "address": {
    "@type": "PostalAddress",
    "addressCountry": "CO",
    "addressRegion": "Colombia"
  },
  "areaServed": {
    "@type": "Country",
    "name": "Colombia"
  },
  "priceRange": "$$",
  "sameAs": [
    "https://wa.me/573239004028",
    "https://www.instagram.com/nortia.col",
    "https://www.linkedin.com/company/nortia",
    "https://www.facebook.com/nortia.col"
  ]
};
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="keywords" content={keywords} />
  <meta name="author" content="NORTIA" />

  <!-- Directivas de Indexación para Motores de Búsqueda -->
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />

  <!-- Canónica e Internacionalización Hreflang para Colombia (SEO Técnico) -->
  <link rel="canonical" href={canonicalUrl} />
  <link rel="alternate" hreflang="es-CO" href={canonicalUrl} />
  <link rel="alternate" hreflang="es" href={canonicalUrl} />
  <link rel="alternate" hreflang="x-default" href={canonicalUrl} />

  <!-- Preload de imagen Hero para optimización de LCP (Core Web Vitals) -->
  <link rel="preload" as="image" href="/assets/img/happy-family.webp" type="image/webp" />

  <!-- Georreferenciación para SEO Local Colombia -->
  <meta name="geo.region" content="CO" />
  <meta name="geo.placename" content="Colombia" />

  <!-- OpenGraph (WhatsApp, Facebook, LinkedIn) -->
  <meta property="og:site_name" content="NORTIA" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="es_CO" />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:alt" content="NORTIA Seguros Colombia" />

  <!-- Twitter Cards -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <!-- Favicons -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="alternate icon" href="/favicon.ico" />

  <!-- Preconnect & Fuentes Google -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400;1,500;1,600&display=swap"
    rel="stylesheet"
  />
  <link
    href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=swap"
    rel="stylesheet"
  />

  <!-- Datos Estructurados Schema.org (JSON-LD) para Rich Snippets en Google -->
  <JsonLd schema={organizationSchema} />
  {schemas.map((schema) => (
    <JsonLd schema={schema} />
  ))}
</head>
<body>
  <Header waTopic={waTopic} />
  <Drawer waTopic={waTopic} />

  <slot />

  <Footer waTopic={waTopic} />
  <FloatingWhatsApp waTopic={waTopic} />

  <script>
    import { initInteractions } from '@scripts/interactions.js';
    initInteractions();
  </script>
</body>
</html>
