---
import { Image } from 'astro:assets';
import { SITE_CONTENT } from '@data/content.js';
import { ASSETS } from '@data/assets.js';

interface Props {
  waTopic?: string;
}

const { waTopic = 'general' } = Astro.props;
const { footer, brand, coberturas } = SITE_CONTENT;
const phone = brand.phone;
const waMessages = SITE_CONTENT.whatsappMessages as Record<string, string>;
const message = waMessages[waTopic] || waMessages.general || '';
const waLink = `https://wa.me/${phone}?text=${encodeURIComponent(message)}`;
---

<footer>
  <div class="footer-inner">
    <div class="footer-grid">
      <!-- Marca -->
      <div class="footer-brand">
        <a href="/">
          <Image src={ASSETS.logos.footer} alt={brand.name} width={160} height={42} />
        </a>
        <p>{footer.brandDesc}</p>
        <div class="footer-social">
          {brand.social?.instagram && (
            <a href={brand.social.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram de NORTIA" title="Instagram">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
              </svg>
            </a>
          )}
          {brand.social?.linkedin && (
            <a href={brand.social.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn de NORTIA" title="LinkedIn">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
                <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 8.76a1.67 1.67 0 1 0 0-3.34 1.67 1.67 0 0 0 0 3.34m1.39 9.74V9.95H5.07v8.55h2.78z"/>
              </svg>
            </a>
          )}
          {brand.social?.facebook && (
            <a href={brand.social.facebook} target="_blank" rel="noopener noreferrer" aria-label="Facebook de NORTIA" title="Facebook">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
                <path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z"/>
              </svg>
            </a>
          )}
        </div>
      </div>

      <!-- Enlaces -->
      <div class="footer-links">
        <div class="footer-col">
          <h4>{footer.col1Title}</h4>
          <ul>
            <li><a href="/personas/">{coberturas.cards[0]?.title || 'Personas y familias'}</a></li>
            <li><a href="/hogar/">{coberturas.cards[1]?.title || 'Hogar y patrimonio'}</a></li>
            <li><a href="/empresas/">{coberturas.cards[2]?.title || 'Empresas y pymes'}</a></li>
            <li><a href="/movilidad/">{coberturas.cards[3]?.title || 'Movilidad y vehículos'}</a></li>
            <li><a href="/creditos/">{coberturas.cards[4]?.title || 'Crédito y financiación'}</a></li>
          </ul>
        </div>

        <div class="footer-col">
          <h4>{footer.col2Title}</h4>
          <ul>
            <li><a href="/#editorial">Prevención</a></li>
            <li><a href="/#camino">El Camino</a></li>
            <li><a href={waLink} target="_blank" rel="noopener noreferrer" data-wa-topic={waTopic} class="wa-btn">Asesoría Privada</a></li>
          </ul>
        </div>

        <div class="footer-col">
          <h4>{footer.col3Title}</h4>
          <ul>
            <li>
              <a href={waLink} target="_blank" rel="noopener noreferrer" data-wa-topic={waTopic} class="wa-btn wa-link">
                <span class="material-symbols-outlined" style="font-size:16px">chat</span>
                <span>WhatsApp Directo</span>
              </a>
            </li>
            <li><a href={`mailto:${brand.email}`}>{brand.email}</a></li>
            <li class="location">
              <span class="material-symbols-outlined" style="font-size:16px">location_on</span>
              <span>{brand.location}</span>
            </li>
          </ul>
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <p>© {brand.copyrightYear} {brand.name}. Todos los derechos reservados.</p>
      <div class="footer-bottom-links">
        <a href="/terminos/">{footer.termsText}</a>
        <a href="/privacidad/">{footer.privacyText}</a>
      </div>
    </div>
  </div>
</footer>
