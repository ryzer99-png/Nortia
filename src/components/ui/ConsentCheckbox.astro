---
interface Props {
  id?: string;
  theme?: "light" | "dark";
  class?: string;
  align?: "left" | "center";
}

const {
  id = "consent-checkbox-" + Math.random().toString(36).substring(2, 7),
  theme = "dark",
  class: className = "",
  align = "left",
} = Astro.props;
---

<div
  class={`nortia-consent-wrapper theme-${theme} align-${align} ${className}`}
  data-consent-container
>
  <label for={id} class="consent-label">
    <div class="checkbox-container">
      <input
        type="checkbox"
        id={id}
        name="autoriza_datos"
        class="nortia-consent-input"
        required
      />
      <div class="custom-checkbox" aria-hidden="true">
        <svg viewBox="0 0 16 16" class="check-svg" fill="none">
          <path
            d="M3.5 8.5L6.5 11.5L12.5 4.5"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </div>
    </div>
    <span class="consent-text">
      Autorizo el tratamiento de mis datos de acuerdo con la
      <button
        type="button"
        class="legal-policy-trigger"
        data-open-privacy-modal
        title="Consultar Política de Tratamiento de Datos"
      >
        Política de Tratamiento de Datos
      </button>
      de NORTIA para recibir mi cotización y asesoría.
    </span>
  </label>

  <!-- Micro-aviso accesible si intenta continuar sin aceptar -->
  <div class="consent-error-tooltip" data-consent-tooltip role="alert" aria-live="polite">
    <span class="material-symbols-outlined tooltip-icon">info</span>
    <span>Por favor, acepta la política para continuar con tu cotización</span>
  </div>
</div>

<style>
  .nortia-consent-wrapper {
    position: relative;
    display: flex;
    flex-direction: column;
    width: 100%;
    max-width: 540px;
    user-select: none;
    font-family: 'Montserrat', sans-serif;
  }

  .nortia-consent-wrapper.align-center {
    align-items: center;
    margin-left: auto;
    margin-right: auto;
  }

  .nortia-consent-wrapper.align-left {
    align-items: flex-start;
  }

  .consent-label {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    cursor: pointer;
    border-radius: 10px;
    padding: 8px 12px;
    transition: all 0.2s ease;
    width: 100%;
    box-sizing: border-box;
  }

  /* Checkbox Container y Custom Checkbox */
  .checkbox-container {
    position: relative;
    display: inline-flex;
    flex-shrink: 0;
    margin-top: 1.5px;
  }

  .nortia-consent-input {
    position: absolute;
    opacity: 0;
    width: 100%;
    height: 100%;
    cursor: pointer;
    margin: 0;
    z-index: 2;
  }

  .custom-checkbox {
    width: 17px;
    height: 17px;
    border-radius: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    box-sizing: border-box;
  }

  .check-svg {
    width: 11px;
    height: 11px;
    opacity: 0;
    transform: scale(0.6);
    transition: all 0.18s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .nortia-consent-input:checked + .custom-checkbox .check-svg {
    opacity: 1;
    transform: scale(1);
  }

  .nortia-consent-input:focus-visible + .custom-checkbox {
    outline: 2px solid var(--secondary, #D9A52B);
    outline-offset: 2px;
  }

  /* Texto */
  .consent-text {
    font-size: 12px;
    line-height: 1.45;
    letter-spacing: -0.01em;
  }

  /* Tema Oscuro (Hero, Final CTA) */
  .theme-dark .consent-label {
    background: rgba(16, 27, 77, 0.42);
    border: 1px solid rgba(247, 244, 239, 0.16);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .theme-dark .consent-label:hover {
    background: rgba(16, 27, 77, 0.58);
    border-color: rgba(217, 165, 43, 0.35);
  }

  .theme-dark .consent-text {
    color: rgba(247, 244, 239, 0.92);
  }

  .theme-dark .custom-checkbox {
    background: rgba(16, 27, 77, 0.5);
    border: 1.5px solid rgba(247, 244, 239, 0.45);
  }

  .theme-dark .nortia-consent-input:checked + .custom-checkbox {
    background: var(--secondary, #D9A52B);
    border-color: var(--secondary, #D9A52B);
    box-shadow: 0 0 10px rgba(217, 165, 43, 0.4);
  }

  .theme-dark .custom-checkbox .check-svg {
    color: var(--primary, #101B4D);
  }

  .theme-dark .legal-policy-trigger {
    color: var(--secondary, #D9A52B);
  }

  /* Tema Claro (Cards, Subpáginas, Modales) */
  .theme-light .consent-label {
    background: rgba(255, 255, 255, 0.88);
    border: 1px solid rgba(208, 201, 190, 0.6);
    backdrop-filter: blur(6px);
  }

  .theme-light .consent-label:hover {
    background: #ffffff;
    border-color: var(--primary, #101B4D);
  }

  .theme-light .consent-text {
    color: var(--on-surface-variant, #5C6478);
  }

  .theme-light .custom-checkbox {
    background: #ffffff;
    border: 1.5px solid rgba(92, 100, 120, 0.4);
  }

  .theme-light .nortia-consent-input:checked + .custom-checkbox {
    background: var(--primary, #101B4D);
    border-color: var(--primary, #101B4D);
    box-shadow: 0 2px 6px rgba(16, 27, 77, 0.2);
  }

  .theme-light .custom-checkbox .check-svg {
    color: #ffffff;
  }

  .theme-light .legal-policy-trigger {
    color: var(--primary, #101B4D);
  }

  /* Enlace / Botón Modal Trigger */
  .legal-policy-trigger {
    background: none;
    border: none;
    padding: 0;
    margin: 0;
    font-family: inherit;
    font-size: inherit;
    font-weight: 600;
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 2.5px;
    display: inline;
    transition: opacity 0.2s ease;
  }

  .legal-policy-trigger:hover {
    opacity: 0.8;
  }

  /* Tooltip de error / atención */
  .consent-error-tooltip {
    display: none;
    align-items: center;
    gap: 6px;
    font-size: 0.76rem;
    font-weight: 600;
    color: #fff;
    background: #e11d48;
    padding: 6px 12px;
    border-radius: 8px;
    margin-top: 6px;
    box-shadow: 0 4px 12px rgba(225, 29, 72, 0.35);
    animation: shakeAttention 0.45s ease forwards;
    width: fit-content;
  }

  .align-center .consent-error-tooltip {
    margin-left: auto;
    margin-right: auto;
  }

  .consent-error-tooltip.is-visible {
    display: inline-flex;
  }

  .tooltip-icon {
    font-size: 15px;
    flex-shrink: 0;
  }

  @keyframes shakeAttention {
    0%, 100% { transform: translateX(0); }
    20%, 60% { transform: translateX(-4px); }
    40%, 80% { transform: translateX(4px); }
  }

  .shake-attention .consent-label {
    border-color: #e11d48 !important;
    box-shadow: 0 0 12px rgba(225, 29, 72, 0.45) !important;
    animation: shakeAttention 0.4s ease;
  }
</style>
