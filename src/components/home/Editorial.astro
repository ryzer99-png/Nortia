---
import { SITE_CONTENT } from '@data/content.js';

const { editorial } = SITE_CONTENT;
---

<section id="editorial">
  <div class="editorial-glow"></div>
  <div style="max-width:1280px;margin:0 auto;position:relative;z-index:10">
    <div class="editorial-grid" style="display:grid;gap:32px;margin-bottom:64px">
      <div style="display:flex;flex-direction:column;gap:20px">
        <div class="editorial-chip">
          <span style="width:6px;height:6px;border-radius:50%;background:var(--secondary);display:inline-block"></span>
          <span>{editorial.chip}</span>
        </div>
        <h2 class="scroll-reveal reveal-fade-up">
          <span>{editorial.titleMain}</span><br />
          <span>{editorial.titleHighlight}</span>
        </h2>
        <p class="scroll-reveal reveal-fade-up delay-100" style="font-size:18px;color:var(--primary-dim)">
          {editorial.subtitle}
        </p>
      </div>
      <div class="scroll-reveal reveal-fade-up delay-200">
        <div class="editorial-quote">
          <div class="left-bar"></div>
          <p set:html={editorial.quoteHtml} />
        </div>
      </div>
    </div>

    <slot />
  </div>
</section>
