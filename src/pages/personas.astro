---
import Layout from '@layouts/Layout.astro';
import SubpageHero from '@components/subpage/SubpageHero.astro';
import SubpageRisk from '@components/subpage/SubpageRisk.astro';
import SubpageScenarios from '@components/subpage/SubpageScenarios.astro';
import SubpagePlans from '@components/subpage/SubpagePlans.astro';
import SubpageFaqs from '@components/subpage/SubpageFaqs.astro';
import FinalCta from '@components/ui/FinalCta.astro';
import { PERSONAS_DATA } from '@data/coverages/life.js';
import { ASSETS } from '@data/assets.js';

const sub = PERSONAS_DATA.subpage;
const risk = PERSONAS_DATA.riskSpotlight;
const bgImage = ASSETS.coberturas.personas;
const waTopic = 'personas';

const siteUrl = 'https://nortia.com.co';
const title = 'Seguro de Vida y Salud Privada en Colombia | Medicina Prepagada - NORTIA';
const description = 'Tranquilidad médica y respaldo económico para tu familia. Medicina prepagada, pólizas de vida, accidentes y rentas educativas con las mejores aseguradoras de Colombia.';
const keywords = 'seguro de vida colombia, medicina prepagada colombia, poliza de salud privada, seguro accidentes personales, seguro vida sura, coomeva medicina prepagada, allianz salud, nortia personas';

// Schema.org FAQPage para Rich Snippets en Google
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": sub.faqs.map(faq => ({
    "@type": "Question",
    "name": faq.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.a
    }
  }))
};

// Schema.org Breadcrumbs
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Inicio",
      "item": siteUrl
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": sub.breadcrumb,
      "item": `${siteUrl}/personas`
    }
  ]
};
---

<Layout
  title={title}
  description={description}
  keywords={keywords}
  waTopic={waTopic}
  ogImage={`${siteUrl}${bgImage}`}
  schemas={[breadcrumbSchema, faqSchema]}
>
  <main>
    <SubpageHero
      breadcrumb={sub.breadcrumb}
      badge={sub.badge}
      title={sub.title}
      subtitle={sub.subtitle}
      ctaHero={sub.ctaHero}
      bgImage={bgImage}
      waTopic={waTopic}
    />

    <SubpageRisk
      riskBadge={sub.riskBadge}
      riskSpotlight={risk}
      riskCtaBtn={sub.riskCtaBtn}
      waTopic={waTopic}
    />

    <SubpageScenarios
      chip="Escenarios y tipos de protección"
      title="Protección según tu momento de vida"
      subtitle="La cobertura ideal para cuidar a quienes más quieres y asegurar su porvenir."
      quote={sub.scenariosQuote}
      scenarios={sub.scenarios}
      waTopic={waTopic}
    />

    <SubpagePlans
      plansChip={sub.plansChip}
      plansTitle={sub.plansTitle}
      plansSubtitle={sub.plansSubtitle}
      plans={sub.plans}
      waTopic={waTopic}
      targetNoun="Familia"
    />

    <SubpageFaqs
      faqsChip={sub.faqsChip}
      faqsTitle={sub.faqsTitle}
      faqs={sub.faqs}
    />

    <FinalCta
      title={sub.finalCtaTitle}
      subtitle={sub.finalCtaSubtitle}
      btnText={sub.finalCtaBtn}
      waTopic={waTopic}
    />
  </main>
</Layout>
