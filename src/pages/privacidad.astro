---
import Layout from '@layouts/Layout.astro';
import { SITE_CONTENT } from '@data/content.js';

const title = 'Política de Privacidad y Tratamiento de Datos | NORTIA';
const description = 'Política de privacidad y protección de datos personales de NORTIA en cumplimiento de la Ley 1581 de 2012 en Colombia.';
---

<Layout title={title} description={description} waTopic="general">
  <main style="max-width: 800px; margin: 0 auto; padding: 140px 24px 80px; color: var(--text);">
    <a href="/" aria-label="Volver al inicio" style="display: inline-flex; align-items: center; gap: 8px; color: var(--text-muted); text-decoration: none; font-size: 0.9rem; margin-bottom: 24px;">
      <span class="material-symbols-outlined" aria-hidden="true" style="font-size: 18px;">arrow_back</span>
      <span>Volver al inicio</span>
    </a>

    <h1 style="font-size: 2.2rem; font-weight: 700; margin-bottom: 16px; color: var(--text-dark);">Política de Privacidad</h1>
    <p style="color: var(--text-muted); font-size: 0.95rem; margin-bottom: 32px;">Cumplimiento Ley 1581 de 2012 y Decreto 1377 de 2013 (Colombia)</p>

    <div class="privacy-content-card" style="line-height: 1.7; font-size: 1rem; display: flex; flex-direction: column; gap: 28px; background: #fff; padding: 36px 32px; border-radius: 16px; border: 1px solid rgba(208,201,190,0.5); box-shadow: 0 4px 20px rgba(16,27,77,0.04);">
      <section>
        <h2 style="font-size: 1.3rem; font-weight: 700; margin-bottom: 12px; color: var(--primary);">1. Responsable del Tratamiento de Datos</h2>
        <p style="margin-bottom: 14px;">
          <strong>{SITE_CONTENT.legal.policyContent.responsable.razonSocial}</strong>, en calidad de Correduría de Seguros, es la entidad responsable del tratamiento de los datos personales suministrados voluntariamente por los titulares y usuarios a través del portal oficial y sus canales digitales de atención.
        </p>
        <ul style="list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 10px; background: rgba(16,27,77,0.02); border: 1px solid rgba(208,201,190,0.5); border-radius: 10px; padding: 14px 18px;">
          <li><strong>Domicilio Principal:</strong> {SITE_CONTENT.legal.policyContent.responsable.domicilio}</li>
          <li><strong>Portal Web:</strong> <a href={SITE_CONTENT.legal.policyContent.responsable.sitioWeb} style="color: var(--primary); font-weight: 600;" target="_blank" rel="noopener">{SITE_CONTENT.legal.policyContent.responsable.sitioWeb}</a></li>
          <li><strong>Correo Electrónico:</strong> <a href={`mailto:${SITE_CONTENT.legal.policyContent.responsable.email}`} style="color: var(--primary); font-weight: 600;">{SITE_CONTENT.legal.policyContent.responsable.email}</a></li>
          <li><strong>Línea Telefónica:</strong> {SITE_CONTENT.legal.policyContent.responsable.telefono}</li>
        </ul>
      </section>

      <section>
        <h2 style="font-size: 1.3rem; font-weight: 700; margin-bottom: 10px; color: var(--primary);">2. Finalidades del Tratamiento de la Información</h2>
        <p>
          {SITE_CONTENT.legal.policyContent.finalidades.description}
        </p>
        <ul style="padding-left: 20px; margin-top: 10px; display: flex; flex-direction: column; gap: 8px;">
          {SITE_CONTENT.legal.policyContent.finalidades.items.map((item: string) => (
            <li style="color: var(--text-dark);">{item}</li>
          ))}
        </ul>
      </section>

      <section>
        <h2 style="font-size: 1.3rem; font-weight: 700; margin-bottom: 10px; color: var(--primary);">3. Derechos del Titular (Derechos ARCO)</h2>
        <p>
          {SITE_CONTENT.legal.policyContent.derechos.description}
        </p>
        <ul style="padding-left: 20px; margin-top: 10px; display: flex; flex-direction: column; gap: 8px;">
          {SITE_CONTENT.legal.policyContent.derechos.items.map((derecho: string) => (
            <li style="color: var(--text-dark);">{derecho}</li>
          ))}
        </ul>
      </section>

      <section style="background: rgba(16,27,77,0.03); border: 1px dashed rgba(217,165,43,0.5); padding: 20px; border-radius: 12px;">
        <h2 style="font-size: 1.3rem; font-weight: 700; margin-bottom: 10px; color: var(--primary);">4. Canales de Atención y Ejercicio de Derechos (Habeas Data)</h2>
        <p>
          {SITE_CONTENT.legal.policyContent.canales.description}
        </p>
        <p style="margin-top: 10px;">
          <strong>Correo electrónico de Habeas Data:</strong>{' '}
          <a href={`mailto:${SITE_CONTENT.legal.policyContent.canales.email}?subject=${encodeURIComponent(SITE_CONTENT.legal.policyContent.canales.asuntoRecomendado)}`} style="color: var(--primary); font-weight: 700;">
            {SITE_CONTENT.legal.policyContent.canales.email}
          </a>
        </p>
        <p style="margin-top: 6px; font-size: 0.9rem; color: var(--text-muted);">
          ⏱ {SITE_CONTENT.legal.policyContent.canales.tiempoRespuesta}
        </p>
      </section>
    </div>
  </main>
</Layout>
