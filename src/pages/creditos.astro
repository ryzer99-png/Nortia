---
import Layout from '@layouts/Layout.astro';
import SubpageHero from '@components/subpage/SubpageHero.astro';
import SubpageRisk from '@components/subpage/SubpageRisk.astro';
import SubpageScenarios from '@components/subpage/SubpageScenarios.astro';
import SubpageVehicleCredit from '@components/subpage/SubpageVehicleCredit.astro';
import SubpageFaqs from '@components/subpage/SubpageFaqs.astro';
import FinalCta from '@components/ui/FinalCta.astro';
import { CREDITOS_DATA } from '@data/coverages/credit.js';
import { ASSETS } from '@data/assets.js';

const sub = CREDITOS_DATA.subpage;
const risk = CREDITOS_DATA.riskSpotlight;
const credit = sub.vehicleCredit;
const bgImage = ASSETS.coberturas.creditos;
const waTopic = 'creditos';

const siteUrl = 'https://nortia.com.co';
const title = 'Crédito para Vehículo 100% Digital y Libre Inversión en Colombia | NORTIA';
const description = 'Solicita tu crédito para vehículo nuevo o usado, compra de cartera y libre inversión con garantía de vehículo en Colombia. Estudio simultáneo con Sufi, Banco de Occidente y Banco de Bogotá.';
const keywords = 'credito vehiculo colombia, credito para carro usado nuevo, compra de cartera vehiculo, libre inversion prenda vehiculo, sura alternativas credito, sufi autos, banco de occidente vehiculos, banco de bogota credito auto, nortia';

// Schema.org FAQPage para Rich Snippets en Google
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": sub.faqs.map(faq => ({
    "@type": "Question",
    "name": faq.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.a
    }
  }))
};

// Schema.org Breadcrumbs
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Inicio",
      "item": siteUrl
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": sub.breadcrumb,
      "item": `${siteUrl}/creditos`
    }
  ]
};
---

<Layout
  title={title}
  description={description}
  keywords={keywords}
  waTopic={waTopic}
  ogImage={`${siteUrl}${bgImage}`}
  schemas={[breadcrumbSchema, faqSchema]}
>
  <main>
    <SubpageHero
      breadcrumb={sub.breadcrumb}
      badge={sub.badge}
      title={sub.title}
      subtitle={sub.subtitle}
      ctaHero={sub.ctaHero}
      bgImage={bgImage}
      waTopic={waTopic}
    />

    <SubpageRisk
      riskBadge={sub.riskBadge}
      riskSpotlight={risk}
      riskCtaBtn={sub.riskCtaBtn}
      waTopic={waTopic}
    />

    <SubpageScenarios
      chip="Opciones de financiación"
      title="Alternativas según tus metas financieras"
      subtitle="Financiación para compra, optimización de cuota mensual y liquidez con respaldo de tu vehículo."
      quote={sub.scenariosQuote}
      scenarios={sub.scenarios}
      waTopic={waTopic}
    />

    {credit && (
      <SubpageVehicleCredit
        data={credit}
        waTopic={waTopic}
      />
    )}

    <SubpageFaqs
      faqsChip={sub.faqsChip}
      faqsTitle={sub.faqsTitle}
      faqs={sub.faqs}
      waTopic={waTopic}
    />

    <FinalCta
      title={sub.finalCtaTitle}
      subtitle={sub.finalCtaSubtitle}
      btnText={sub.finalCtaBtn}
      waTopic={waTopic}
    />
  </main>
</Layout>
