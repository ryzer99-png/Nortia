---
import Layout from '@layouts/Layout.astro';
import Hero from '@components/home/Hero.astro';
import CoberturasGrid from '@components/home/CoberturasGrid.astro';
import Editorial from '@components/home/Editorial.astro';
import OfficialData from '@components/home/OfficialData.astro';
import TrustBanner from '@components/home/TrustBanner.astro';
import CaminoSteps from '@components/home/CaminoSteps.astro';
import FinalCta from '@components/ui/FinalCta.astro';
import { SITE_CONTENT } from '@data/content.js';

const title = "NORTIA | Asesoría y Cotización de Seguros en Colombia";
const description = "Cotiza seguros de vida, salud, autos, hogar y empresas en Colombia con Sura, Allianz y Bolívar. Asesoría experta en Bucaramanga y Santander. ¡Cotiza hoy!";
const keywords = "seguros colombia, asesoria en seguros bucaramanga, cotizar seguro autos, seguro de vida colombia, medicina prepagada, seguro de hogar santander, seguros pymes colombia, sura, allianz, bolivar, nortia";

// Schema.org FAQPage para Rich Snippets en Google
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "¿Cómo cotizar un seguro con NORTIA en Bucaramanga y Colombia?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Puedes solicitar tu asesoría personalizada a través de nuestro botón de WhatsApp o canales oficiales. Analizamos tu perfil de riesgo, comparamos ofertas objetivas entre las principales aseguradoras de Colombia y te presentamos la mejor opción sin costo adicional."
      }
    },
    {
      "@type": "Question",
      "name": "¿Con cuáles compañías aseguradoras trabaja NORTIA?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "NORTIA trabaja como corredor de seguros aliado de las aseguradoras líderes del país, entre ellas SURA, Allianz, HDI Seguros, Seguros Bolívar, Coomeva Medicina Prepagada, AXA Colpatria, Seguros Mundial y La Equidad Seguros."
      }
    },
    {
      "@type": "Question",
      "name": "¿Qué tipos de pólizas y seguros puedo comparar y contratar?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Ofrecemos asesoría y cotización en seguros de movilidad (todo riesgo para autos y motos), pólizas para el hogar y patrimonio familiar, seguros de vida y salud con medicina prepagada, pólizas empresariales (cumplimiento, responsabilidad civil, multirriesgo) y soluciones de crédito y financiación."
      }
    },
    {
      "@type": "Question",
      "name": "¿Tiene algún costo adicional cotizar con NORTIA en vez de directamente con la aseguradora?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. Nuestra asesoría experta y acompañamiento continuo ante siniestros no tiene ningún sobrecosto para el cliente. Pagas la tarifa oficial de la aseguradora con el beneficio de contar con un equipo especializado que defiende tus intereses."
      }
    }
  ]
};
---

<Layout
  title={title}
  description={description}
  keywords={keywords}
  waTopic="general"
  ogImage="https://nortia.com.co/assets/img/og-preview.webp"
  schemas={[faqSchema]}
>
  <main id="main-content">
    <Hero />
    <CoberturasGrid />
    <Editorial>
      <OfficialData />
    </Editorial>
    <TrustBanner />
    <CaminoSteps />
    <FinalCta
      title={SITE_CONTENT.finalCta.title}
      subtitle={SITE_CONTENT.finalCta.subtitle}
      btnText={SITE_CONTENT.finalCta.btnText}
      waTopic="general"
    />
  </main>
</Layout>
