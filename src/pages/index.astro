---
import Layout from '@layouts/Layout.astro';
import Hero from '@components/home/Hero.astro';
import CoberturasGrid from '@components/home/CoberturasGrid.astro';
import Editorial from '@components/home/Editorial.astro';
import OfficialData from '@components/home/OfficialData.astro';
import TrustBanner from '@components/home/TrustBanner.astro';
import CaminoSteps from '@components/home/CaminoSteps.astro';
import FinalCta from '@components/ui/FinalCta.astro';
import { SITE_CONTENT } from '@data/content.js';

const title = "NORTIA | Asesoría en Seguros y Protección Patrimonial en Colombia";
const description = "Compara y contrata seguros de vida, salud, hogar, autos y empresas en Colombia con las mejores aseguradoras del país (SURA, Allianz, Bolívar, AXA). Asesoría experta sin intermediación de dinero.";
const keywords = "seguros colombia, asesoria en seguros, cotizar seguros colombia, seguro de vida, medicina prepagada colombia, seguro de hogar, seguro todo riesgo autos, seguros para pymes colombia, sura, allianz, nortia";
---

<Layout
  title={title}
  description={description}
  keywords={keywords}
  waTopic="general"
  ogImage="https://nortia.com.co/assets/img/happy-family.jpg"
>
  <main>
    <Hero />
    <CoberturasGrid />
    <Editorial>
      <OfficialData />
    </Editorial>
    <TrustBanner />
    <CaminoSteps />
    <FinalCta
      title={SITE_CONTENT.finalCta.title}
      subtitle={SITE_CONTENT.finalCta.subtitle}
      btnText={SITE_CONTENT.finalCta.btnText}
      waTopic="general"
    />
  </main>
</Layout>
