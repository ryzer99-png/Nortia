---
import Layout from '@layouts/Layout.astro';
import SubpageHero from '@components/subpage/SubpageHero.astro';
import SubpageRisk from '@components/subpage/SubpageRisk.astro';
import SubpageScenarios from '@components/subpage/SubpageScenarios.astro';
import SubpagePlans from '@components/subpage/SubpagePlans.astro';
import SubpageFaqs from '@components/subpage/SubpageFaqs.astro';
import FinalCta from '@components/ui/FinalCta.astro';
import { HOGAR_DATA } from '@data/coverages/home.js';
import { ASSETS } from '@data/assets.js';

const sub = HOGAR_DATA.subpage;
const risk = HOGAR_DATA.riskSpotlight;
const bgImage = ASSETS.coberturas.hogar;
const waTopic = 'hogar';

const siteUrl = 'https://nortia.com.co';
const title = 'Seguro de Hogar y Patrimonio en Colombia | Cobertura Sismo e Incendio - NORTIA';
const description = 'Protege tu vivienda, apartamento y enseres contra terremotos, sismos, incendios, inundaciones y hurtos. Coberturas para propietarios e inquilinos en Colombia.';
const keywords = 'seguro de hogar colombia, poliza hogar, seguro vivienda sismo, seguro para inquilinos, seguro contra incendios casa, seguro sura hogar, allianz hogar, nortia';

// Schema.org FAQPage para Rich Snippets en Google
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": sub.faqs.map(faq => ({
    "@type": "Question",
    "name": faq.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.a
    }
  }))
};

// Schema.org Breadcrumbs
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Inicio",
      "item": siteUrl
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": sub.breadcrumb,
      "item": `${siteUrl}/hogar`
    }
  ]
};
---

<Layout
  title={title}
  description={description}
  keywords={keywords}
  waTopic={waTopic}
  ogImage={`${siteUrl}${bgImage}`}
  schemas={[breadcrumbSchema, faqSchema]}
>
  <main>
    <SubpageHero
      breadcrumb={sub.breadcrumb}
      badge={sub.badge}
      title={sub.title}
      subtitle={sub.subtitle}
      ctaHero={sub.ctaHero}
      bgImage={bgImage}
      waTopic={waTopic}
    />

    <SubpageRisk
      riskBadge={sub.riskBadge}
      riskSpotlight={risk}
      riskCtaBtn={sub.riskCtaBtn}
      waTopic={waTopic}
    />

    <SubpageScenarios
      chip="Escenarios y tipos de riesgo"
      title="¿Qué situaciones y riesgos debes considerar?"
      subtitle="Identificamos los riesgos imprevistos que pueden afectar tu vivienda y patrimonio."
      quote={sub.scenariosQuote}
      scenarios={sub.scenarios}
      waTopic={waTopic}
    />

    <SubpagePlans
      plansChip={sub.plansChip}
      plansTitle={sub.plansTitle}
      plansSubtitle={sub.plansSubtitle}
      plans={sub.plans}
      waTopic={waTopic}
      targetNoun="Hogar"
    />

    <SubpageFaqs
      faqsChip={sub.faqsChip}
      faqsTitle={sub.faqsTitle}
      faqs={sub.faqs}
    />

    <FinalCta
      title={sub.finalCtaTitle}
      subtitle={sub.finalCtaSubtitle}
      btnText={sub.finalCtaBtn}
      waTopic={waTopic}
    />
  </main>
</Layout>
