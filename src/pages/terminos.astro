---
import Layout from '@layouts/Layout.astro';
import { SITE_CONTENT } from '@data/content.js';

const title = 'Términos y Condiciones | NORTIA';
const description = 'Términos y condiciones de uso de los servicios de asesoría, comparación y corretaje de seguros de NORTIA en Colombia.';
const { brand } = SITE_CONTENT;
---

<Layout title={title} description={description} waTopic="general">
  <main class="legal-page">
    <div class="legal-container">
      <a href="/" aria-label="Volver al inicio" class="legal-back-link">
        <span class="material-symbols-outlined" aria-hidden="true">arrow_back</span>
        <span>Volver al inicio</span>
      </a>

      <h1 class="legal-page-title">Términos y Condiciones</h1>
      <p class="legal-page-meta">Última actualización: Enero de 2026</p>

      <div class="legal-card">
        <section class="legal-section">
          <h2>1. Naturaleza de los Servicios</h2>
          <p>
            {brand.name} actúa como consultora y asesora en intermediación y corretaje de seguros en Colombia. Nuestro propósito es ofrecer acompañamiento experto, análisis de riesgos y comparación independiente de pólizas ofrecidas por compañías de seguros legalmente autorizadas por la Superintendencia Financiera de Colombia.
          </p>
        </section>

        <section class="legal-section">
          <h2>2. Cero Intermediación de Dinero</h2>
          <p>
            En {brand.name} <strong>no recibimos dinero en efectivo, transferencias personales ni gestionamos recaudos directos de primas</strong>. El pago de cualquier póliza se realiza de forma directa y transparente entre el cliente y la compañía aseguradora correspondiente (SURA, Allianz, Bolívar, AXA Colpatria, entre otras) a través de sus canales oficiales de facturación y pasarelas bancarias.
          </p>
        </section>

        <section class="legal-section">
          <h2>3. Responsabilidad y Coberturas</h2>
          <p>
            Las condiciones generales, exclusiones, deducibles y coberturas de cada seguro corresponden a los clausulados contractuales expedidos por la respectiva compañía aseguradora. La asesoría brindada busca orientar la toma de decisiones informadas conforme al perfil de riesgo suministrado por el usuario.
          </p>
        </section>

        <section class="legal-section legal-highlight-box">
          <h2>4. Contacto y Canales Oficiales</h2>
          <p>
            Cualquier comunicación o solicitud formal puede dirigirse a nuestro correo electrónico oficial:{' '}
            <a href={`mailto:${brand.email}`} class="legal-email-link">{brand.email}</a> o a través de nuestra línea autorizada de WhatsApp corporativo.
          </p>
        </section>
      </div>
    </div>
  </main>
</Layout>

<style>
  .legal-page {
    padding: 120px 24px 80px;
    color: var(--on-surface);
  }

  .legal-container {
    max-width: 800px;
    margin: 0 auto;
  }

  .legal-back-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--on-surface-variant);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 500;
    margin-bottom: 24px;
    transition: color 0.2s ease;
  }

  .legal-back-link:hover {
    color: var(--primary);
  }

  .legal-page-title {
    font-family: 'Montserrat', sans-serif;
    font-size: clamp(28px, 4vw, 36px);
    font-weight: 700;
    margin-bottom: 12px;
    color: var(--primary);
  }

  .legal-page-meta {
    color: var(--on-surface-variant);
    font-size: 0.95rem;
    margin-bottom: 32px;
  }

  .legal-card {
    line-height: 1.7;
    font-size: 1rem;
    display: flex;
    flex-direction: column;
    gap: 28px;
    background: #ffffff;
    padding: 36px 32px;
    border-radius: 16px;
    border: 1px solid rgba(var(--primary-rgb), 0.08);
    box-shadow: 0 4px 20px rgba(16, 27, 77, 0.04);
  }

  .legal-section h2 {
    font-family: 'Montserrat', sans-serif;
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: 10px;
    color: var(--primary);
  }

  .legal-highlight-box {
    background: rgba(var(--primary-rgb), 0.02);
    border: 1px dashed rgba(var(--secondary-rgb), 0.6);
    padding: 20px;
    border-radius: 12px;
  }

  .legal-email-link {
    color: var(--primary);
    font-weight: 700;
    text-decoration: underline;
  }

  @media (max-width: 640px) {
    .legal-card {
      padding: 24px 20px;
    }
  }
</style>
