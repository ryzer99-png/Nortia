---
import Layout from '@layouts/Layout.astro';
import SubpageHero from '@components/subpage/SubpageHero.astro';
import SubpageRisk from '@components/subpage/SubpageRisk.astro';
import SubpageScenarios from '@components/subpage/SubpageScenarios.astro';
import SubpagePlans from '@components/subpage/SubpagePlans.astro';
import SubpageFaqs from '@components/subpage/SubpageFaqs.astro';
import FinalCta from '@components/ui/FinalCta.astro';
import { EMPRESAS_DATA } from '@data/coverages/business.js';
import { ASSETS } from '@data/assets.js';

const sub = EMPRESAS_DATA.subpage;
const risk = EMPRESAS_DATA.riskSpotlight;
const bgImage = ASSETS.coberturas.empresas;
const waTopic = 'empresas';

const siteUrl = 'https://nortia.com.co';
const title = 'Seguros para Empresas, Pymes y Pólizas de Cumplimiento | NORTIA';
const description = 'Blindaje empresarial en Colombia: seguros de cumplimiento para contratos, responsabilidad civil (RCE), todo riesgo pyme y bienestar para empleados.';
const keywords = 'seguros para empresas colombia, seguros pymes, poliza de cumplimiento contratos, responsabilidad civil extracontractual, seguro salud colectiva empleados, arl, sura empresas, allianz empresas, nortia';

// Schema.org FAQPage para Rich Snippets en Google
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": sub.faqs.map(faq => ({
    "@type": "Question",
    "name": faq.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.a
    }
  }))
};

// Schema.org Breadcrumbs
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Inicio",
      "item": siteUrl
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": sub.breadcrumb,
      "item": `${siteUrl}/empresas`
    }
  ]
};
---

<Layout
  title={title}
  description={description}
  keywords={keywords}
  waTopic={waTopic}
  ogImage={`${siteUrl}${bgImage}`}
  schemas={[breadcrumbSchema, faqSchema]}
>
  <main>
    <SubpageHero
      breadcrumb={sub.breadcrumb}
      badge={sub.badge}
      title={sub.title}
      subtitle={sub.subtitle}
      ctaHero={sub.ctaHero}
      bgImage={bgImage}
      waTopic={waTopic}
    />

    <SubpageRisk
      riskBadge={sub.riskBadge}
      riskSpotlight={risk}
      riskCtaBtn={sub.riskCtaBtn}
      waTopic={waTopic}
    />

    <SubpageScenarios
      chip="Escenarios y blindaje corporativo"
      title="Protección según tu actividad y tamaño"
      subtitle="La cobertura ideal para proteger tus activos, tu equipo y la continuidad de tu operación."
      quote={sub.scenariosQuote}
      scenarios={sub.scenarios}
      waTopic={waTopic}
    />

    <SubpagePlans
      plansChip={sub.plansChip}
      plansTitle={sub.plansTitle}
      plansSubtitle={sub.plansSubtitle}
      plans={sub.plans}
      waTopic={waTopic}
      targetNoun="Empresa"
    />

    <SubpageFaqs
      faqsChip={sub.faqsChip}
      faqsTitle={sub.faqsTitle}
      faqs={sub.faqs}
    />

    <FinalCta
      title={sub.finalCtaTitle}
      subtitle={sub.finalCtaSubtitle}
      btnText={sub.finalCtaBtn}
      waTopic={waTopic}
    />
  </main>
</Layout>
