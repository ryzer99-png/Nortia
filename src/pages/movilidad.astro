---
import Layout from '@layouts/Layout.astro';
import SubpageHero from '@components/subpage/SubpageHero.astro';
import SubpageRisk from '@components/subpage/SubpageRisk.astro';
import SubpageScenarios from '@components/subpage/SubpageScenarios.astro';
import SubpagePlans from '@components/subpage/SubpagePlans.astro';
import SubpageFaqs from '@components/subpage/SubpageFaqs.astro';
import FinalCta from '@components/ui/FinalCta.astro';
import { MOVILIDAD_DATA } from '@data/coverages/mobility.js';
import { ASSETS } from '@data/assets.js';

const sub = MOVILIDAD_DATA.subpage;
const risk = MOVILIDAD_DATA.riskSpotlight;
const bgImage = ASSETS.coberturas.movilidad;
const waTopic = 'movilidad';

const siteUrl = 'https://nortia.com.co';
const title = 'Seguro Todo Riesgo para Autos y Motos en Colombia | NORTIA';
const description = 'Compara y cotiza tu seguro todo riesgo para autos, motos y flotas en Colombia. Cobertura por pérdida total, hurto y daños a terceros con asistencia 24/7.';
const keywords = 'seguro todo riesgo autos colombia, seguro para motos colombia, cotizar seguro carro, seguro todo riesgo sura, allianz autos, seguros bolivar autos, soat digital, nortia';

// Schema.org FAQPage para Rich Snippets en Google
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": sub.faqs.map(faq => ({
    "@type": "Question",
    "name": faq.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.a
    }
  }))
};

// Schema.org Breadcrumbs
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Inicio",
      "item": siteUrl
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": sub.breadcrumb,
      "item": `${siteUrl}/movilidad`
    }
  ]
};
---

<Layout
  title={title}
  description={description}
  keywords={keywords}
  waTopic={waTopic}
  ogImage={`${siteUrl}${bgImage}`}
  schemas={[breadcrumbSchema, faqSchema]}
>
  <main>
    <SubpageHero
      breadcrumb={sub.breadcrumb}
      badge={sub.badge}
      title={sub.title}
      subtitle={sub.subtitle}
      ctaHero={sub.ctaHero}
      bgImage={bgImage}
      waTopic={waTopic}
    />

    <SubpageRisk
      riskBadge={sub.riskBadge}
      riskSpotlight={risk}
      riskCtaBtn={sub.riskCtaBtn}
      waTopic={waTopic}
    />

    <SubpageScenarios
      chip="Escenarios y tipos de movilidad"
      title="Protección según la forma en que te mueves"
      subtitle="La cobertura adecuada depende del uso real que le das a tu medio de transporte."
      quote={sub.scenariosQuote}
      scenarios={sub.scenarios}
      waTopic={waTopic}
    />

    <SubpagePlans
      plansChip={sub.plansChip}
      plansTitle={sub.plansTitle}
      plansSubtitle={sub.plansSubtitle}
      plans={sub.plans}
      waTopic={waTopic}
      targetNoun="Vehículo"
    />

    <SubpageFaqs
      faqsChip={sub.faqsChip}
      faqsTitle={sub.faqsTitle}
      faqs={sub.faqs}
    />

    <FinalCta
      title={sub.finalCtaTitle}
      subtitle={sub.finalCtaSubtitle}
      btnText={sub.finalCtaBtn}
      waTopic={waTopic}
    />
  </main>
</Layout>
